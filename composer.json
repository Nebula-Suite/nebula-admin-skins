        }
    },
    "homepage": "https://github.com/Nebula-Suite/nebula-admin-skins",
    "support": {
        "source": "https://github.com/Nebula-Suite/nebula-admin-skins",
        "issues": "https://github.com/Nebula-Suite/nebula-admin-skins/issues"
    }
