{
    "name": "nebula/module-admin-skins",
    "description": "Thirteen extra colour schemes for the Nebula admin theme for Magento Open Source and MageOS.",
    "type": "magento2-module",
    "license": "proprietary",
    "authors": [
        {
            "name": "Qoliber",
            "homepage": "https://qoliber.com"
        },
        {
            "name": "Siteation",
            "homepage": "https://siteation.dev"
        }
    ],
    "require": {
        "nebula/module-skin": "^1.3",
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0"
